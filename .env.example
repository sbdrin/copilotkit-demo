# 后端模式：deepseek = 直连 DeepSeek 代理；ag-ui = 转发到远程 AG-UI 端点
BACKEND_MODE=deepseek

# OpenAI 兼容 API Key
LLM_API_KEY=sk-your-api-key

# API 根地址（OpenAI 兼容，通常带 /v1）
LLM_BASE_URL=https://www.dmxapi.cn/v1

# 模型名称
LLM_MODEL=deepseek-v4-flash-0731

# 服务端端口
PORT=3001

# 以下 AGNO_* 配置仅在 BACKEND_MODE=ag-ui 时生效
# Agno 后端使用 jwt-token 请求头（非 Authorization Bearer）
AGNO_AGUI_URL=https://your-agui-host/api/v1/agui
AGNO_JWT_TOKEN=your-jwt-token
AGNO_AGENT_CODE=AGENT_005
